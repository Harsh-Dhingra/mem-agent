{
  "manifest_version": 3,
  "name": "mem-agent tab bridge",
  "version": "0.2.0",
  "description": "Reports tab inventory to the mem-agent daemon and discards inactive tabs it approves. Tabs reload instantly when clicked.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "sw.js"
  }
}
